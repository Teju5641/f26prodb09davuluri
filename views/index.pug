
extends layout

block content
  h1= title
  p Welcome to my Express application!

  button(type="button", class="btn btn-secondary", onclick="reduce()") Sample Button

  div#use.mt-3 take some away

  p.mt-3
    a(href="/rivers") View River Search Results

  script.
    let current = 11;
    let quantity = 2;

    function reduce() {
      current = current - quantity;
      if (current < 0) {
        current = 0;
      }
      document.getElementById("use").innerHTML = `Reduced by ${quantity} to ${current}`;
    }
