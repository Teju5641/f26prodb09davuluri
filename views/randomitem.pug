
extends layout

block content
  h1= title

  -
    let image_names = [
      "nile.jpg",
      "amazon.jpg",
      "mississippi.jpg",
      "ganges.jpg",
      "yangtze.jpg"
    ];

  - for(let i = 0; i < 3; i++) {
    - let randomIndex = Math.floor(Math.random()*5)
    - let selectedImage = image_names[randomIndex]
    img(src=`/images/${selectedImage}`, alt=`River ${selectedImage}`, height="300", width="300")
  - }
