
extends layout

block content
  div.river-page
    div.river-page-header
      p.river-eyebrow RIVER COLLECTION
      h1= title
      p.river-subtitle View river information and details.

    if toShow == null
      div.river-card
        h2 River Not Found
        p There is no river with this ID.
        a.btn.btn-outline-secondary(href='/rivers') Back to Rivers

    else
      div.river-card
        div.river-card-top
          span.river-badge RIVER PROFILE
          h2= toShow.river_name
          p.river-subtitle River information from MongoDB

        dl.river-info
          div.river-info-row
            dt River ID
            dd= toShow._id

          div.river-info-row
            dt River Name
            dd= toShow.river_name

          div.river-info-row
            dt Country
            dd= toShow.country

          div.river-info-row
            dt Length (km)
            dd= toShow.length_km

        a.btn.btn-primary(href='/rivers') Back to Rivers
