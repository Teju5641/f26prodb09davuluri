extends layout

block content
  .container-fluid.mt-4.px-4
    h1= title
    - let items = results;

    .row
      each item in items
        .col-md-4.mb-3
          p River: #{item.river_name}
          p Country: #{item.country}
          p Length: #{item.length_km} km
          a.btn.btn-primary(href='/rivers/update?id=' + item._id) Update