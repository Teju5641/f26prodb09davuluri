
extends layout

block content
  h1= title

  - let items = results

  div.container-fluid
    div.row
      each item, index in items
        div.col-sm-2(onclick=`buy(${index})`)
          p River: #{item.river_name}
          p Country: #{item.country}
          p Length: #{item.length_km} km

  script.
    function buy(index) {
      alert(`You selected river ${index}`);
    }
